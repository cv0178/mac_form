{
  "name": "fill_form",
  "productName": "智填助手",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge package && electron-builder --win nsis --prepackaged out/智填助手-win32-x64",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": "weiwe",
  "license": "MIT",
  "build": {
    "appId": "com.fillform.assistant",
    "productName": "智填助手",
    "directories": {
      "output": "out/installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智填助手",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.21",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-squirrel-startup": "^1.0.1",
    "vue-router": "^4.6.4"
  }
}
